volumes:
  mongo-data:
  mongo-config:
  keys:

networks:
  internal:
  {{ komodo_network }}:
    external: true

services:
  mongo:
    image: {{ komodo_mongo_image }}
    command: --quiet --wiredTigerCacheSizeGB 0.25
    restart: unless-stopped
    networks:
      - internal
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    environment:
      MONGO_INITDB_ROOT_USERNAME: {{ komodo_db_username }}
      MONGO_INITDB_ROOT_PASSWORD: {{ komodo_db_password }}
    labels:
      - komodo.skip=

  core:
    image: ghcr.io/moghtech/komodo-core:{{ komodo_image_tag }}
    init: true
    restart: unless-stopped
    depends_on:
      - mongo
    ports:
      - "127.0.0.1:9120:9120"
    volumes:
      - keys:/config/keys
    environment:
      KOMODO_DATABASE_ADDRESS: mongo:27017
      KOMODO_DATABASE_USERNAME: {{ komodo_db_username }}
      KOMODO_DATABASE_PASSWORD: {{ komodo_db_password }}
      KOMODO_HOST: https://{{ komodo_domain }}
      KOMODO_TITLE: Komodo
      KOMODO_PERIPHERY_PUBLIC_KEY: file:/config/keys/periphery.pub
      KOMODO_LOCAL_AUTH: "true"
      KOMODO_INIT_ADMIN_USERNAME: {{ komodo_admin_username }}
      KOMODO_INIT_ADMIN_PASSWORD: {{ komodo_admin_password }}
      KOMODO_WEBHOOK_SECRET: {{ komodo_webhook_secret }}
      KOMODO_JWT_SECRET: {{ komodo_jwt_secret }}
      KOMODO_FIRST_SERVER_NAME: "{{ komodo_core_host }}"
{% if komodo_oidc_enabled %}
      KOMODO_OIDC_ENABLED: "true"
      KOMODO_OIDC_PROVIDER: "{{ komodo_oidc_provider }}"
      KOMODO_OIDC_CLIENT_ID: "{{ komodo_oidc_client_id }}"
      KOMODO_OIDC_CLIENT_SECRET: "{{ komodo_oidc_client_secret }}"
      KOMODO_OIDC_USE_FULL_EMAIL: "{{ komodo_oidc_use_full_email | default(false) | lower }}"
{% endif %}
      TZ: {{ komodo_timezone }}
    networks:
      - internal
      - {{ komodo_network }}
    labels:
      - komodo.skip=
      - traefik.enable=true
      - traefik.http.routers.komodo.rule=Host(`{{ komodo_domain }}`)
      - traefik.http.services.komodo.loadbalancer.server.port=9120
      - traefik.http.routers.komodo.tls.certresolver=myresolver

  ## Local Periphery for this host itself, shares the `keys` volume with Core,
  ## so it authenticates via the co-located key exchange, not an onboarding key.
  periphery:
    image: ghcr.io/moghtech/komodo-periphery:{{ komodo_image_tag }}
    init: true
    restart: unless-stopped
    depends_on:
      - core
    networks:
      - internal
    volumes:
      - keys:/config/keys
      - /var/run/docker.sock:/var/run/docker.sock
      - /proc:/proc
      - {{ komodo_periphery_root_directory }}:{{ komodo_periphery_root_directory }}
    environment:
      PERIPHERY_CORE_ADDRESS: ws://core:9120
      PERIPHERY_CONNECT_AS: "{{ komodo_core_host }}"
      PERIPHERY_CORE_PUBLIC_KEYS: file:/config/keys/core.pub
      PERIPHERY_ROOT_DIRECTORY: "{{ komodo_periphery_root_directory }}"
    labels:
      - komodo.skip=
