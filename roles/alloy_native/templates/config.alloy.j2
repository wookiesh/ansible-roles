// Grafana Alloy configuration (native, non-Docker) — generated by Ansible

local.file "grafana_api_key" {
  filename  = "/etc/alloy/grafana_cloud_api_key"
  is_secret = true
}

{% if alloy_native_log_targets | length > 0 %}
// --- Local log files ---

{% for log in alloy_native_log_targets %}
loki.source.file "{{ log.job_name }}" {
  targets = [
    {__path__ = "{{ log.path }}", job = "{{ log.job_name }}", instance = "{{ inventory_hostname }}"},
  ]
  forward_to = [loki.write.grafana_cloud.receiver]
}

{% endfor %}
{% endif %}
loki.write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_native_grafana_cloud_loki_url }}"

    basic_auth {
      username = "{{ alloy_native_grafana_cloud_loki_username }}"
      password = local.file.grafana_api_key.content
    }
  }

  external_labels = {
    host        = constants.hostname,
    environment = "{{ alloy_native_environment }}",
{% if alloy_native_cluster %}
    cluster     = "{{ alloy_native_cluster }}",
{% endif %}
  }
}

{% if alloy_native_scrape_targets | length > 0 %}
// --- Local Prometheus scrape targets ---

{% for scrape in alloy_native_scrape_targets %}
prometheus.scrape "{{ scrape.job_name }}" {
  targets         = [{"__address__" = "{{ scrape.address }}", "instance" = "{{ inventory_hostname }}"}]
  scrape_interval = "{{ scrape.scrape_interval | default(alloy_native_scrape_interval) }}"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

{% endfor %}
{% endif %}
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_native_grafana_cloud_prometheus_url }}"

    basic_auth {
      username = "{{ alloy_native_grafana_cloud_prometheus_username }}"
      password = local.file.grafana_api_key.content
    }
  }

  external_labels = {
    host        = constants.hostname,
    environment = "{{ alloy_native_environment }}",
{% if alloy_native_cluster %}
    cluster     = "{{ alloy_native_cluster }}",
{% endif %}
  }
}
