// Managed by Ansible - server role. Local edits will be overwritten.
{% if ansible_distribution == 'Ubuntu' %}
// Automatically upgrade packages from these (origin:archive) pairs
Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}";
	"${distro_id}:${distro_codename}-security";
	"${distro_id}ESMApps:${distro_codename}-apps-security";
	"${distro_id}ESM:${distro_codename}-infra-security";
{% if server_unattended_upgrades_include_updates %}
	"${distro_id}:${distro_codename}-updates";
{% endif %}
};
{% else %}
// Origins-Pattern controls which packages are upgraded (keyword=value pairs,
// matched against the package's Release file metadata)
Unattended-Upgrade::Origins-Pattern {
	"origin=Debian,codename=${distro_codename},label=Debian";
	"origin=Debian,codename=${distro_codename},label=Debian-Security";
	"origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
{% if server_unattended_upgrades_include_updates %}
	"origin=Debian,codename=${distro_codename}-updates";
{% endif %}
};
{% endif %}

// Python regular expressions, matching packages to exclude from upgrading
Unattended-Upgrade::Package-Blacklist {
{% for pkg in server_unattended_upgrades_blacklist %}
	"{{ pkg }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ server_unattended_upgrades_automatic_reboot | lower }}";
Unattended-Upgrade::Automatic-Reboot-WithUsers "{{ server_unattended_upgrades_automatic_reboot_with_users | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ server_unattended_upgrades_automatic_reboot_time }}";
