// Grafana Alloy configuration — generated by Ansible

{% if alloy_loki_enabled or alloy_metrics_enabled %}
local.file "grafana_api_key" {
  filename  = "/run/secrets/grafana_cloud_api_key"
  is_secret = true
}

{% endif %}
{% if alloy_traefik_logs_enabled and alloy_traefik_log_path and alloy_loki_enabled %}
// --- Traefik access log collection ---

local.file_match "traefik_access" {
  path_targets = [{"__path__" = "{{ alloy_traefik_log_path }}/*.log"}]
  sync_period  = "5s"
}

loki.source.file "traefik_access" {
  targets    = local.file_match.traefik_access.targets
  forward_to = [loki.process.traefik_json.receiver]
}

loki.process "traefik_json" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.json {
    expressions = {
      method     = "RequestMethod",
      status     = "DownstreamStatus",
      router     = "RouterName",
      service    = "ServiceName",
      entrypoint = "entryPointName",
    }
  }

  stage.labels {
    values = {
      method     = "method",
      status     = "status",
      router     = "router",
      service    = "service",
      entrypoint = "entrypoint",
    }
  }
}

{% endif %}
{% if alloy_loki_enabled %}
// --- Loki remote write ---

loki.write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_grafana_cloud_loki_url }}"

    basic_auth {
      username = "{{ alloy_grafana_cloud_loki_username }}"
      password = local.file.grafana_api_key.content
    }
  }

  external_labels = {
    host        = constants.hostname,
    environment = "{{ alloy_environment }}",
{% if alloy_cluster %}
    cluster     = "{{ alloy_cluster }}",
{% endif %}
{% for key, value in (alloy_extra_labels | default({})).items() %}
    {{ key }} = "{{ value }}",
{% endfor %}
  }
}

{% endif %}
{% if alloy_metrics_enabled %}
// --- Traefik metrics scraping ---

prometheus.scrape "traefik" {
  targets         = [{"__address__" = "localhost:{{ alloy_traefik_metrics_port }}"}]
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

{% endif %}
{% if alloy_metrics_enabled and alloy_extra_scrape_targets | length > 0 %}
// --- Extra remote scrape targets (native exporters on non-Docker hosts) ---
//
// This config file is identical on every replica of a `global`-mode Swarm
// service, and on this repo's swarm clusters /opt/docker is a *shared*
// GlusterFS volume — there is no such thing as "per-host" content here, so
// host-scoping cannot be done via Jinja/inventory_hostname at template time
// (every replica renders the same file). Instead, dedup at Alloy's own
// runtime using constants.hostname (genuinely distinct per container) via a
// relabel step, so only one designated replica's samples survive.
{% if alloy_extra_scrape_targets_host | length > 0 %}
prometheus.relabel "extra_scrape_dedup" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  rule {
    source_labels = ["origin_host"]
    regex         = "{{ alloy_extra_scrape_targets_host }}"
    action        = "keep"
  }
}
{% endif %}

{% for scrape in alloy_extra_scrape_targets %}
prometheus.scrape "{{ scrape.job_name }}" {
  targets = [
{% for target in scrape.targets %}
    {"__address__" = "{{ target.address }}", "instance" = "{{ target.instance | default(target.address) }}", "origin_host" = constants.hostname},
{% endfor %}
  ]
  scrape_interval = "{{ scrape.scrape_interval | default(alloy_scrape_interval) }}"
  forward_to      = [{{ 'prometheus.relabel.extra_scrape_dedup.receiver' if alloy_extra_scrape_targets_host | length > 0 else 'prometheus.remote_write.grafana_cloud.receiver' }}]
}

{% endfor %}
{% endif %}
{% if alloy_metrics_enabled %}
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "{{ alloy_grafana_cloud_prometheus_url }}"

    basic_auth {
      username = "{{ alloy_grafana_cloud_prometheus_username }}"
      password = local.file.grafana_api_key.content
    }
  }

  external_labels = {
    host        = constants.hostname,
    environment = "{{ alloy_environment }}",
{% if alloy_cluster %}
    cluster     = "{{ alloy_cluster }}",
{% endif %}
  }
}

{% endif %}
