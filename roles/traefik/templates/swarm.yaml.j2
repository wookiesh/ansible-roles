version: '3.8'

volumes:
  letsencrypt:

networks:
  {{ traefik_network_name }}:
    external: true
    driver: {{ traefik_network_driver }}
    attachable: {{ traefik_network_attachable }}

secrets:
  {{ traefik_tls_secret_cert }}:
    external: true
  {{ traefik_tls_secret_key }}:
    external: true

services:
  proxy:
    image: traefik:{{ traefik_version }}
    cap_add:
      - NET_ADMIN
      - NET_BIND_SERVICE
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - letsencrypt:/letsencrypt
      - {{ traefik_config_dir }}/dynamic:/etc/traefik/dynamic
      - {{ traefik_config_dir }}/static.yaml:/etc/traefik/traefik.yaml
{% if traefik_access_log_path %}
      - {{ traefik_access_log_path }}:{{ traefik_access_log_path }}
{% endif %}
    secrets:
      - {{ traefik_tls_secret_cert }}
      - {{ traefik_tls_secret_key }}
{% if traefik_port_mode == "host" %}
    ports:
      - target: 80
        published: 80
        mode: host
      - target: 443
        published: 443
        mode: host
      - target: 8883
        published: 8883
        mode: host
      - target: 8899
        published: 8899
        mode: host
      - target: 3306
        published: 3306
        mode: host
{% else %}
    ports:
      - "{{ traefik_static_config.entryPoints.web.address | regex_replace(':(\\d+)', '\\1') }}:80"
      - "{{ traefik_static_config.entryPoints.websecure.address | regex_replace(':(\\d+)', '\\1') }}:443"
      - "{{ traefik_static_config.entryPoints.mqttsecure.address | regex_replace(':(\\d+)', '\\1') }}:8883"
      - "{{ traefik_static_config.entryPoints.metrics.address | regex_replace(':(\\d+)', '\\1') }}:8899"
{% endif %}
    environment: {{ traefik_environment }}
    networks:
      - {{ traefik_network_name }}
{% if traefik_healthcheck_enabled %}
    healthcheck:
      test: ["CMD", "traefik" ,"healthcheck", "--ping"]
      interval: {{ traefik_healthcheck_interval }}
      timeout: {{ traefik_healthcheck_timeout }}
      retries: {{ traefik_healthcheck_retries }}
{% endif %}
    deploy:
      labels:
        - traefik.enable=true
        - traefik.http.routers.traefik.rule=Host(`{{ traefik_domain }}`)
        - traefik.http.routers.traefik.service=api@internal
        - traefik.http.routers.traefik.entrypoints=websecure
        - traefik.http.routers.traefik.middlewares=internal-only@file
        - traefik.http.services.traefik.loadbalancer.server.port=1337
        - "wud.tag.include=^v[0-9]+\\.[0-9]+\\.[0-9]+$$"
{% if traefik_swarm_mode == "global" %}
      mode: global
{% else %}
      mode: replicated
      replicas: {{ traefik_swarm_replicas }}
{% endif %}
{% if traefik_swarm_placement_constraints | length > 0 or traefik_swarm_placement_preferences | length > 0 %}
      placement:
{% if traefik_swarm_placement_constraints | length > 0 %}
        constraints:
{% for constraint in traefik_swarm_placement_constraints %}
          - {{ constraint }}
{% endfor %}
{% endif %}
{% if traefik_swarm_placement_preferences | length > 0 %}
        preferences:
{% for preference in traefik_swarm_placement_preferences %}
          - {{ preference }}
{% endfor %}
{% endif %}
{% endif %}
      restart_policy:
        condition: {{ traefik_swarm_restart_policy.condition }}
        delay: {{ traefik_swarm_restart_policy.delay }}
        max_attempts: {{ traefik_swarm_restart_policy.max_attempts }}
        window: {{ traefik_swarm_restart_policy.window }}
      resources:
        limits:
          cpus: '{{ traefik_swarm_resources.limits.cpus }}'
          memory: {{ traefik_swarm_resources.limits.memory }}
        reservations:
          cpus: '{{ traefik_swarm_resources.reservations.cpus }}'
          memory: {{ traefik_swarm_resources.reservations.memory }}

{% if traefik_whoami_enabled %}
  whoami:
    image: traefik/whoami:latest
    networks:
      - {{ traefik_network_name }}
    environment:
      - TZ={{ traefik_environment.TZ }}
    deploy:
      labels:
        - traefik.enable=true
        - traefik.http.routers.whoami.rule=Host(`{{ traefik_whoami_domain }}`)
        - traefik.http.routers.whoami.entrypoints=websecure
        - traefik.http.routers.whoami.middlewares=internal-only@file
        - traefik.http.services.whoami.loadbalancer.server.port=80
      mode: replicated
      replicas: 1
      restart_policy:
        condition: any
        delay: 5s
        max_attempts: 3
        window: 120s
{% endif %}

{% if traefik_visualizer_enabled %}
  visualizer:
    image: dockersamples/visualizer:latest
    networks:
      - {{ traefik_network_name }}
    environment:
      - TZ={{ traefik_environment.TZ }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    deploy:
      labels:
        - traefik.enable=true
        - traefik.http.routers.visualizer.rule=Host(`{{ traefik_visualizer_domain }}`)
        - traefik.http.routers.visualizer.entrypoints=websecure
        - traefik.http.routers.visualizer.middlewares=internal-only@file
        - traefik.http.services.visualizer.loadbalancer.server.port=8080
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
        delay: 5s
        max_attempts: 3
        window: 120s
{% endif %}
