# Tailscale daemon environment configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Network configuration
PORT="{{ tailscale_port }}"
TUN="{{ tailscale_tun_device }}"
USERSPACE_NETWORKING="{{ 'true' if tailscale_userspace_networking else 'false' }}"

# DNS configuration
{% if tailscale_accept_dns %}
ACCEPT_DNS="true"
{% endif %}
{% if tailscale_dns_servers %}
DNS="{{ tailscale_dns_servers | join(',') }}"
{% endif %}

# Logging configuration
DEBUG="{{ 'true' if tailscale_debug_mode else 'false' }}"
LOG_LEVEL="{{ tailscale_log_level }}"

# Control server configuration
{% if tailscale_control_url %}
CONTROL_URL="{{ tailscale_control_url }}"
{% endif %}
{% if tailscale_control_cert %}
CONTROL_CERT="{{ tailscale_control_cert }}"
{% endif %}

# Performance tuning
HEARTBEAT_INTERVAL="{{ tailscale_heartbeat_interval }}"
KEEPALIVE_INTERVAL="{{ tailscale_keepalive_interval }}"

# Advanced configuration
{% if tailscale_derp_region %}
DERP_REGION="{{ tailscale_derp_region }}"
{% endif %}
MTU="{{ tailscale_mtu }}"

# Environment variables from role configuration
{% for key, value in tailscale_environment.items() %}
{{ key }}="{{ value }}"
{% endfor %}