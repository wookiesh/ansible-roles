#!/bin/bash
# Keepalived status script
# Generated by Ansible

set -euo pipefail

# Configuration
KEEPALIVED_CONFIG="{{ keepalived_config_file }}"
KEEPALIVED_SERVICE="{{ keepalived_service_name }}"
STATS_SOCKET="{{ keepalived_stats_socket }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== Keepalived Status Report ===${NC}"
echo

# Service status
echo -e "${YELLOW}Service Status:${NC}"
if systemctl is-active --quiet "$KEEPALIVED_SERVICE"; then
    echo -e "  Status: ${GREEN}Active${NC}"
    echo -e "  Enabled: $(systemctl is-enabled "$KEEPALIVED_SERVICE")"
else
    echo -e "  Status: ${RED}Inactive${NC}"
fi
echo

# Process information
echo -e "${YELLOW}Process Information:${NC}"
if pgrep -f keepalived > /dev/null; then
    echo -e "  PID: $(pgrep -f keepalived)"
    echo -e "  Memory: $(ps -o pid,vsz,rss,comm -p $(pgrep -f keepalived) | tail -1 | awk '{print $2" KB (VSZ), "$3" KB (RSS)"}')"
    echo -e "  Uptime: $(ps -o pid,etime,comm -p $(pgrep -f keepalived) | tail -1 | awk '{print $2}')"
else
    echo -e "  ${RED}Process not running${NC}"
fi
echo

# VRRP status
echo -e "${YELLOW}VRRP Status:${NC}"
if command -v keepalived >/dev/null 2>&1; then
    if keepalived --dump-data 2>/dev/null | grep -q "VRRP Instance"; then
        keepalived --dump-data 2>/dev/null | grep -A 10 "VRRP Instance" | while read -r line; do
            if [[ $line == *"VRRP Instance"* ]]; then
                echo -e "  ${GREEN}$line${NC}"
            elif [[ $line == *"State"* ]]; then
                if [[ $line == *"MASTER"* ]]; then
                    echo -e "    ${GREEN}$line${NC}"
                elif [[ $line == *"BACKUP"* ]]; then
                    echo -e "    ${YELLOW}$line${NC}"
                else
                    echo -e "    ${RED}$line${NC}"
                fi
            else
                echo -e "    $line"
            fi
        done
    else
        echo -e "  ${YELLOW}No VRRP instances configured or data not available${NC}"
    fi
else
    echo -e "  ${RED}Keepalived command not found${NC}"
fi
echo

# Virtual IPs
echo -e "${YELLOW}Virtual IPs:${NC}"
if command -v ip >/dev/null 2>&1; then
    # Extract VIPs from config and check if they're configured
    if [[ -f "$KEEPALIVED_CONFIG" ]]; then
        grep -E "^\s*[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" "$KEEPALIVED_CONFIG" | while read -r line; do
            vip=$(echo "$line" | awk '{print $1}')
            if ip addr show | grep -q "$vip"; then
                echo -e "  ${GREEN}$vip - Configured${NC}"
            else
                echo -e "  ${RED}$vip - Not configured${NC}"
            fi
        done
    else
        echo -e "  ${RED}Configuration file not found: $KEEPALIVED_CONFIG${NC}"
    fi
else
    echo -e "  ${RED}ip command not available${NC}"
fi
echo

# Recent logs
echo -e "${YELLOW}Recent Logs (last 10 lines):${NC}"
if journalctl -u "$KEEPALIVED_SERVICE" --no-pager -n 10 2>/dev/null; then
    :
elif [[ -f "{{ keepalived_log_file }}" ]]; then
    tail -n 10 "{{ keepalived_log_file }}"
else
    echo -e "  ${YELLOW}No logs available${NC}"
fi
echo

# Configuration summary
echo -e "${YELLOW}Configuration Summary:${NC}"
if [[ -f "$KEEPALIVED_CONFIG" ]]; then
    echo -e "  Config file: $KEEPALIVED_CONFIG"
    echo -e "  VRRP instances: $(grep -c "^vrrp_instance" "$KEEPALIVED_CONFIG" || echo "0")"
    echo -e "  Virtual servers: $(grep -c "^virtual_server" "$KEEPALIVED_CONFIG" || echo "0")"
    echo -e "  Track scripts: $(grep -c "^vrrp_script" "$KEEPALIVED_CONFIG" || echo "0")"
    echo -e "  Last modified: $(stat -c %y "$KEEPALIVED_CONFIG" 2>/dev/null || stat -f %Sm "$KEEPALIVED_CONFIG" 2>/dev/null || echo "Unknown")"
else
    echo -e "  ${RED}Configuration file not found${NC}"
fi
echo

echo -e "${BLUE}=== End of Status Report ===${NC}"
