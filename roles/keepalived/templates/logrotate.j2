# Keepalived log rotation configuration
# Generated by Ansible

{{ keepalived_log_file }} {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    create 0644 {{ keepalived_user }} {{ keepalived_group }}
    postrotate
        # Send USR1 signal to keepalived to reopen log files
        /bin/kill -USR1 $(cat /var/run/keepalived.pid 2>/dev/null) 2>/dev/null || true
    endscript
}

# Systemd journal logs (if using systemd)
/var/log/journal/*/*keepalived* {
    weekly
    missingok
    rotate 4
    compress
    delaycompress
    notifempty
}
