# Keepalived Environment Configuration
# Generated by Ansible - Do not edit manually

# Keepalived process options
KEEPALIVED_OPTIONS="--log-console {{ '--log-detail' if keepalived_log_level == 'DEBUG' else '' }} --log-facility={{ keepalived_log_level }}"

# User and group for non-root execution
{% if keepalived_enable_non_root %}
KEEPALIVED_USER="{{ keepalived_user }}"
KEEPALIVED_GROUP="{{ keepalived_group }}"
{% endif %}

# Metrics and monitoring
{% if keepalived_metrics_enabled %}
KEEPALIVED_METRICS="1"
KEEPALIVED_STATS_SOCKET="{{ keepalived_stats_socket }}"
KEEPALIVED_STATS_SOCKET_TIMEOUT="{{ keepalived_stats_socket_timeout }}"
{% endif %}

# Custom configuration directory
KEEPALIVED_CONFIG_DIR="{{ keepalived_config_dir }}"

# Log configuration
{% if keepalived_syslog_enabled %}
KEEPALIVED_SYSLOG="1"
{% endif %}

# Email notification settings
{% if keepalived_email_enabled %}
KEEPALIVED_EMAIL_ENABLED="1"
KEEPALIVED_EMAIL_FROM="{{ keepalived_email_from }}"
KEEPALIVED_EMAIL_SMTP_SERVER="{{ keepalived_email_smtp_server }}"
KEEPALIVED_EMAIL_SMTP_PORT="{{ keepalived_email_smtp_port }}"
{% if keepalived_email_smtp_username %}
KEEPALIVED_EMAIL_SMTP_USERNAME="{{ keepalived_email_smtp_username }}"
{% endif %}
{% if keepalived_email_smtp_tls %}
KEEPALIVED_EMAIL_SMTP_TLS="1"
{% endif %}
{% endif %}
