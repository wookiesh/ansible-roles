# Keepalived Configuration File
# Generated by Ansible - Do not edit manually
# Template: keepalived.conf.j2

# Global Definitions
global_defs {
    router_id {{ keepalived_global_defs.router_id }}
    script_user {{ keepalived_global_defs.script_user }}
    enable_script_security {{ keepalived_global_defs.enable_script_security | lower }}
{% if keepalived_email_enabled %}
    notification_email {
{% for email in keepalived_email_to %}
        {{ email }}
{% endfor %}
    }
    notification_email_from {{ keepalived_email_from }}
    smtp_server {{ keepalived_email_smtp_server }}
    smtp_connect_timeout {{ keepalived_email_smtp_port }}
{% if keepalived_email_smtp_tls %}
    smtp_helo_name {{ ansible_fqdn }}
{% endif %}
{% endif %}
{% if keepalived_global_defs.max_auto_priority is defined %}
    max_auto_priority {{ keepalived_global_defs.max_auto_priority }}
{% endif %}
{% if keepalived_global_defs.min_auto_priority is defined %}
    min_auto_priority {{ keepalived_global_defs.min_auto_priority }}
{% endif %}
{% if keepalived_global_defs.vrrp_mcast_group4 is defined %}
    vrrp_mcast_group4 {{ keepalived_global_defs.vrrp_mcast_group4 }}
{% endif %}
{% if keepalived_global_defs.vrrp_mcast_group6 is defined %}
    vrrp_mcast_group6 {{ keepalived_global_defs.vrrp_mcast_group6 }}
{% endif %}
}

# Static Routes
{% if keepalived_static_routes is defined %}
{% for route in keepalived_static_routes %}
static_routes {
    {{ route }}
}
{% endfor %}
{% endif %}

# VRRP Scripts
{% for script in keepalived_track_scripts %}
vrrp_script {{ script.name }} {
    script "{{ script.script }}"
    interval {{ script.interval }}
{% if script.weight is defined %}
    weight {{ script.weight }}
{% endif %}
{% if script.fall is defined %}
    fall {{ script.fall }}
{% endif %}
{% if script.rise is defined %}
    rise {{ script.rise }}
{% endif %}
{% if script.timeout is defined %}
    timeout {{ script.timeout }}
{% endif %}
}
{% endfor %}

# VRRP Instances
{% for vrrp in keepalived_vrrp_instances %}
vrrp_instance {{ vrrp.name }} {
    state {{ vrrp.state }}
    interface {{ vrrp.interface }}
    virtual_router_id {{ vrrp.virtual_router_id }}
    priority {{ vrrp.priority }}
    advert_int {{ vrrp.advert_int }}
{% if vrrp.authentication is defined %}
    authentication {
        auth_type {{ vrrp.authentication.auth_type }}
        auth_pass {{ vrrp.authentication.auth_pass }}
    }
{% endif %}
{% if vrrp.virtual_ipaddress is defined %}
    virtual_ipaddress {
{% for vip in vrrp.virtual_ipaddress %}
        {{ vip }}
{% endfor %}
    }
{% endif %}
{% if vrrp.virtual_ipaddress_excluded is defined %}
    virtual_ipaddress_excluded {
{% for vip in vrrp.virtual_ipaddress_excluded %}
        {{ vip }}
{% endfor %}
    }
{% endif %}
{% if vrrp.track_scripts is defined %}
    track_script {
{% for script in vrrp.track_scripts %}
        {{ script }}
{% endfor %}
    }
{% endif %}
{% if vrrp.track_interfaces is defined %}
    track_interface {
{% for interface in vrrp.track_interfaces %}
        {{ interface }}
{% endfor %}
    }
{% endif %}
{% if vrrp.track_files is defined %}
    track_file {
{% for file in vrrp.track_files %}
        {{ file }}
{% endfor %}
    }
{% endif %}
{% if vrrp.nopreempt is defined %}
    nopreempt
{% endif %}
{% if vrrp.preempt_delay is defined %}
    preempt_delay {{ vrrp.preempt_delay }}
{% endif %}
{% if vrrp.debug is defined %}
    debug {{ vrrp.debug }}
{% endif %}
{% if vrrp.notify_master is defined %}
    notify_master "{{ vrrp.notify_master }}"
{% endif %}
{% if vrrp.notify_backup is defined %}
    notify_backup "{{ vrrp.notify_backup }}"
{% endif %}
{% if vrrp.notify_fault is defined %}
    notify_fault "{{ vrrp.notify_fault }}"
{% endif %}
{% if vrrp.notify_stop is defined %}
    notify_stop "{{ vrrp.notify_stop }}"
{% endif %}
{% if vrrp.notify is defined %}
    notify {{ vrrp.notify }}
{% endif %}
{% if vrrp.smtp_alert is defined %}
    smtp_alert
{% endif %}
{% if vrrp.lvs_sync_daemon_interface is defined %}
    lvs_sync_daemon_interface {{ vrrp.lvs_sync_daemon_interface }}
{% endif %}
{% if vrrp.lvs_sync_daemon_vip is defined %}
    lvs_sync_daemon_vip {{ vrrp.lvs_sync_daemon_vip }}
{% endif %}
{% if vrrp.garp_interval is defined %}
    garp_interval {{ vrrp.garp_interval }}
{% endif %}
{% if vrrp.vrrp_garp_interval is defined %}
    vrrp_garp_interval {{ vrrp.vrrp_garp_interval }}
{% endif %}
{% if vrrp.vrrp_garp_master_refresh is defined %}
    vrrp_garp_master_refresh {{ vrrp.vrrp_garp_master_refresh }}
{% endif %}
{% if vrrp.vrrp_garp_master_repeat is defined %}
    vrrp_garp_master_repeat {{ vrrp.vrrp_garp_master_repeat }}
{% endif %}
{% if vrrp.vrrp_garp_lower_prio_delay is defined %}
    vrrp_garp_lower_prio_delay {{ vrrp.vrrp_garp_lower_prio_delay }}
{% endif %}
{% if vrrp.gna_interval is defined %}
    gna_interval {{ vrrp.gna_interval }}
{% endif %}
{% if vrrp.unicast_peer is defined %}
    unicast_peer {
{% for peer in vrrp.unicast_peer %}
        {{ peer }}
{% endfor %}
    }
{% endif %}
}
{% endfor %}

# Virtual Servers
{% for vs in keepalived_virtual_servers %}
virtual_server {{ vs.virtual_server }} {
    delay_loop {{ vs.delay_loop }}
    lb_algo {{ vs.lb_algo }}
    lb_kind {{ vs.lb_kind }}
{% if vs.persistence_timeout is defined %}
    persistence_timeout {{ vs.persistence_timeout }}
{% endif %}
{% if vs.persistence_granularity is defined %}
    persistence_granularity {{ vs.persistence_granularity }}
{% endif %}
{% if vs.protocol is defined %}
    protocol {{ vs.protocol }}
{% endif %}
{% if vs.sorry_server is defined %}
    sorry_server {{ vs.sorry_server }}
{% endif %}
{% if vs.real_server is defined %}
{% for rs in vs.real_server %}
    real_server {{ rs }} {
{% if vs.weight is defined %}
        weight {{ vs.weight }}
{% endif %}
{% if vs.delay_before_retry is defined %}
        delay_before_retry {{ vs.delay_before_retry }}
{% endif %}
{% if vs.delay_loop is defined %}
        delay_loop {{ vs.delay_loop }}
{% endif %}
{% if vs.connect_timeout is defined %}
        connect_timeout {{ vs.connect_timeout }}
{% endif %}
{% if vs.retry is defined %}
        retry {{ vs.retry }}
{% endif %}
{% if vs.warmup is defined %}
        warmup {{ vs.warmup }}
{% endif %}
        inhibit_on_failure
    }
{% endfor %}
{% endif %}
}
{% endfor %}

# Additional Configuration
{{ keepalived_extra_config }}
