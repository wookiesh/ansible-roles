#!/bin/bash
# Keepalived monitoring script
# Generated by Ansible

set -euo pipefail

# Configuration
KEEPALIVED_SERVICE="{{ keepalived_service_name }}"
KEEPALIVED_CONFIG="{{ keepalived_config_file }}"
METRICS_FILE="{{ keepalived_config_dir }}/metrics.txt"
STATS_SOCKET="{{ keepalived_stats_socket }}"

# Initialize metrics
echo "timestamp,$(date +%s)" > "$METRICS_FILE"

# Service status
if systemctl is-active --quiet "$KEEPALIVED_SERVICE"; then
    echo "service_status,1" >> "$METRICS_FILE"
else
    echo "service_status,0" >> "$METRICS_FILE"
fi

# Process status
if pgrep -f keepalived > /dev/null; then
    echo "process_running,1" >> "$METRICS_FILE"
    pid=$(pgrep -f keepalived)
    memory=$(ps -o rss= -p "$pid" | tr -d ' ')
    echo "memory_kb,$memory" >> "$METRICS_FILE"
else
    echo "process_running,0" >> "$METRICS_FILE"
    echo "memory_kb,0" >> "$METRICS_FILE"
fi

# VRRP status
if command -v keepalived >/dev/null 2>&1; then
    master_count=0
    backup_count=0
    fault_count=0

    while IFS= read -r line; do
        if [[ $line == *"State = MASTER"* ]]; then
            ((master_count++))
        elif [[ $line == *"State = BACKUP"* ]]; then
            ((backup_count++))
        elif [[ $line == *"State = FAULT"* ]]; then
            ((fault_count++))
        fi
    done < <(keepalived --dump-data 2>/dev/null | grep "State" || true)

    echo "vrrp_masters,$master_count" >> "$METRICS_FILE"
    echo "vrrp_backups,$backup_count" >> "$METRICS_FILE"
    echo "vrrp_faults,$fault_count" >> "$METRICS_FILE"
else
    echo "vrrp_masters,0" >> "$METRICS_FILE"
    echo "vrrp_backups,0" >> "$METRICS_FILE"
    echo "vrrp_faults,0" >> "$METRICS_FILE"
fi

# Virtual IP count
if [[ -f "$KEEPALIVED_CONFIG" ]]; then
    vip_count=$(grep -E "^\s*[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+" "$KEEPALIVED_CONFIG" | wc -l)
    echo "virtual_ips,$vip_count" >> "$METRICS_FILE"
else
    echo "virtual_ips,0" >> "$METRICS_FILE"
fi

# Configuration age
if [[ -f "$KEEPALIVED_CONFIG" ]]; then
    config_age=$(($(date +%s) - $(stat -c %Y "$KEEPALIVED_CONFIG" 2>/dev/null || stat -f %m "$KEEPALIVED_CONFIG" 2>/dev/null || echo "0")))
    echo "config_age_seconds,$config_age" >> "$METRICS_FILE"
else
    echo "config_age_seconds,0" >> "$METRICS_FILE"
fi

# Output metrics in Prometheus format if requested
if [[ "${1:-}" == "--prometheus" ]]; then
    echo "# HELP keepalived_service_status Keepalived service status (1=running, 0=stopped)"
    echo "# TYPE keepalived_service_status gauge"
    echo "keepalived_service_status $(grep "service_status" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_process_running Keepalived process status (1=running, 0=not running)"
    echo "# TYPE keepalived_process_running gauge"
    echo "keepalived_process_running $(grep "process_running" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_memory_kb Keepalived memory usage in KB"
    echo "# TYPE keepalived_memory_kb gauge"
    echo "keepalived_memory_kb $(grep "memory_kb" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_vrrp_masters Number of VRRP instances in MASTER state"
    echo "# TYPE keepalived_vrrp_masters gauge"
    echo "keepalived_vrrp_masters $(grep "vrrp_masters" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_vrrp_backups Number of VRRP instances in BACKUP state"
    echo "# TYPE keepalived_vrrp_backups gauge"
    echo "keepalived_vrrp_backups $(grep "vrrp_backups" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_vrrp_faults Number of VRRP instances in FAULT state"
    echo "# TYPE keepalived_vrrp_faults gauge"
    echo "keepalived_vrrp_faults $(grep "vrrp_faults" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_virtual_ips Number of configured virtual IPs"
    echo "# TYPE keepalived_virtual_ips gauge"
    echo "keepalived_virtual_ips $(grep "virtual_ips" "$METRICS_FILE" | cut -d',' -f2)"

    echo "# HELP keepalived_config_age_seconds Age of configuration file in seconds"
    echo "# TYPE keepalived_config_age_seconds gauge"
    echo "keepalived_config_age_seconds $(grep "config_age_seconds" "$METRICS_FILE" | cut -d',' -f2)"
else
    cat "$METRICS_FILE"
fi
