# SSH Daemon Configuration - Hardened
# Generated by Ansible - Manual modifications will be overwritten

Port {{ ssh_port }}
Protocol {{ ssh_protocol }}

# Authentication
{% if ssh_pikvm_mode %}
# PiKVM-specific SSH configuration
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM yes
{% else %}
# Standard hardened SSH configuration
PermitRootLogin {{ ssh_permit_root_login }}
PasswordAuthentication {{ ssh_password_authentication }}
PermitEmptyPasswords {{ ssh_permit_empty_passwords }}
ChallengeResponseAuthentication {{ ssh_challenge_response_authentication }}
UsePAM {{ ssh_use_pam }}
{% endif %}

# Key-based authentication
AuthorizedKeysFile {{ ssh_authorized_keys_file }}
StrictModes {{ ssh_strict_modes }}

# Connection settings
MaxAuthTries {{ ssh_max_auth_tries }}
MaxSessions {{ ssh_max_sessions }}
LoginGraceTime {{ ssh_login_grace_time }}
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

# Security restrictions
{% if ssh_pikvm_mode %}
# PiKVM-specific security settings
X11Forwarding no
AllowTcpForwarding yes
AllowAgentForwarding no
PermitTunnel no
IgnoreRhosts yes
{% else %}
# Standard hardened security settings
X11Forwarding {{ ssh_x11_forwarding }}
AllowTcpForwarding {{ ssh_allow_tcp_forwarding }}
AllowAgentForwarding {{ ssh_allow_agent_forwarding }}
PermitTunnel {{ ssh_permit_tunnel }}
IgnoreRhosts {{ ssh_ignore_rhosts }}
{% endif %}

# User access control
{% if not ssh_pikvm_mode %}
{% if ssh_allow_groups is defined and ssh_allow_groups|length > 0 %}
AllowGroups {{ ssh_allow_groups|join(' ') }}
{% endif %}
{% if ssh_allow_users is defined and ssh_allow_users|length > 0 %}
AllowUsers {{ ssh_allow_users|join(' ') }}
{% endif %}
{% if ssh_deny_users is defined and ssh_deny_users|length > 0 %}
DenyUsers {{ ssh_deny_users|join(' ') }}
{% endif %}
{% endif %}

# Cryptographic settings
HostKeyAlgorithms {{ ssh_host_key_algorithms }}
KexAlgorithms {{ ssh_kex_algorithms }}
Ciphers {{ ssh_ciphers }}
MACs {{ ssh_macs }}

# Logging
SyslogFacility AUTH
LogLevel VERBOSE

# Banner
{% if ssh_enable_banner %}
Banner {{ ssh_banner }}
{% endif %}

# Subsystem configuration
Subsystem sftp /usr/lib/openssh/sftp-server

# Include additional configuration files
Include /etc/ssh/sshd_config.d/*.conf

{% if ssh_agent_forwarding_groups is defined and ssh_agent_forwarding_groups | length > 0 %}
# Agent forwarding restricted to specific groups
Match Group {{ ssh_agent_forwarding_groups | join(',') }}
    AllowAgentForwarding yes
{% endif %}
